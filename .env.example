# Database
DATABASE_URL=postgresql://sendwise:sendwise@localhost:5432/sendwise

# Redis
REDIS_URL=redis://localhost:6380

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# JWT
JWT_SECRET=your_jwt_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars

# Encryption (for OAuth tokens at rest)
ENCRYPTION_KEY=your_32_byte_hex_encryption_key

# Gemini (AI-powered follow-ups). Leave blank to disable AI follow-ups.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# App
API_PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
NODE_ENV=development
